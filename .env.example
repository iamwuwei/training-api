# ---- AWS / Aurora -----------------------------------------------------------
AWS_REGION=ap-northeast-1
DB_HOST=training.cluster-cvigvl3wbuuw.ap-northeast-1.rds.amazonaws.com
DB_PORT=5432
DB_NAME=postgres
DB_USER=postgres
# aws rds describe-db-clusters --db-cluster-identifier training \
#   --query 'DBClusters[0].DbClusterResourceId' --output text
DB_CLUSTER_RESOURCE_ID=cluster-XXXXXXXXXXXXXXXXXXXXXXXXXX

# ---- Strava (https://www.strava.com/settings/api) ---------------------------
STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=
# any random string; Strava echoes it back when verifying the webhook
STRAVA_VERIFY_TOKEN=

# ---- Claude -----------------------------------------------------------------
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-haiku-4-5
# worker writes a Claude verdict (達成 / 達成但有提醒 / 未達成) for every matched run; "false" to disable
AUTO_REVIEW=true

# ---- auth (Sign in with Apple, web) -----------------------------------------
# Services ID from developer.apple.com (the `client_id` used by Apple's JS SDK)
APPLE_CLIENT_ID=
# random 32+ chars; signs session tokens. Rotating it logs everyone out.
SESSION_SECRET=

# ---- api / auth Lambda CORS (comma-separated) -------------------------------
CORS_ORIGIN=https://training.pages.dev,http://localhost:5173

# ---- filled in after `cdk deploy` (used by npm run subscribe-webhook) -------
WEBHOOK_URL=

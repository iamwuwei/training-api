# ---- AWS / Aurora -----------------------------------------------------------
AWS_REGION=ap-northeast-1
DB_HOST=training.cluster-cvigvl3wbuuw.ap-northeast-1.rds.amazonaws.com
DB_PORT=5432
DB_NAME=postgres
DB_USER=postgres
# aws rds describe-db-clusters --db-cluster-identifier training \
#   --query 'DBClusters[0].DbClusterResourceId' --output text
DB_CLUSTER_RESOURCE_ID=cluster-XXXXXXXXXXXXXXXXXXXXXXXXXX

# ---- Strava (https://www.strava.com/settings/api) ---------------------------
STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=
# any random string; Strava echoes it back when verifying the webhook
STRAVA_VERIFY_TOKEN=

# ---- Claude -----------------------------------------------------------------
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-haiku-4-5
# worker writes a Claude verdict (達成 / 達成但有提醒 / 未達成) for every matched run; "false" to disable
AUTO_REVIEW=true

# ---- naming ----------------------------------------------------------------
# every resource is training-api-<thing>-<STAGE>; the stack is training-api-<STAGE>
STAGE=prod

# ---- front-end origins (comma-separated): API CORS + Cognito callback URLs ----
CORS_ORIGIN=https://training.pages.dev,http://localhost:5173
# Cognito hosted-UI domain prefix; default training-api-prod-<account id>
COGNITO_DOMAIN_PREFIX=

# ---- optional: custom API domain (both or none) ------------------------------
# ACM certificate in ap-northeast-1 for API_DOMAIN, DNS-validated (README §3)
API_DOMAIN=make-it-api.life4like.com
API_CERT_ARN=

# ---- optional: Sign in with Apple through Cognito (all four or none) ---------
# Services ID, Team ID, Key ID and the .p8 contents (\n for newlines) from developer.apple.com
APPLE_SERVICES_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=

# ---- filled in after `cdk deploy` (used by npm run subscribe-webhook) -------
# = <ApiUrl>/strava/webhook, e.g. https://make-it-api.life4like.com/strava/webhook
WEBHOOK_URL=
